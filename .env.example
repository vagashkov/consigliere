APP_VERSION=1.0
ENVIRONMENT=DEVELOPMENT

# LLM provider details
LLM_PROVIDER_TYPE=ollama
LLM_PROVIDER_SCHEMA=http
LLM_PROVIDER_HOST=localhost
LLM_PROVIDER_PORT=11434

# Embedding LLM details
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_MODEL_VERSION=latest

# Generating LLM details
GENERATING_MODEL_NAME=gemma3
GENERATING_MODEL_VERSION=270m
GENERATING_MODEL_TEMPERATURE=0.7

# Service data storage details
STORAGE_TYPE=json