APP_TITLE="Consigliere"
APP_VERSION=1.0
ENVIRONMENT=DEVELOPMENT

# Database credentials
DB_DIALECT=postgresql
DB_DRIVER=psycopg
DB_USERNAME=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_NAME=consigliere

# LLM provider details
LLM_PROVIDER_TYPE=OpenAI
LLM_PROVIDER_SCHEMA=https
LLM_PROVIDER_HOST=openrouter.ai
LLM_PROVIDER_PORT=443
LLM_PROVIDER_AUTH_METHOD=Bearer
LLM_PROVIDER_KEY=

# Embedding LLM details
EMBEDDING_MODEL_NAME=qwen2.5
EMBEDDING_MODEL_VERSION=3b

# Generating LLM details
GENERATING_MODEL_NAME=deepseek/deepseek-r1-0528:free
GENERATING_MODEL_VERSION=
GENERATING_MODEL_TEMPERATURE=0.7

# Cache settings
ACTIVE_STORAGE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Persistent data storage details
PERSISTENT_STORAGE_TYPE=json

# Knowledge base configuration
KNOWLEDGE_BASE_TYPE=raw_text

# Client interaction channels configuration
# Telegram
USE_TELEGRAM=True
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=
DISABLE_PENDING_MESSAGES=False